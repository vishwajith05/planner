PROJECT_NAME="PlanWise AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["*"]

# Database
DATABASE_URL="sqlite:///./planwise.db"

# AI Provider Configuration
# Set to "gemini" when API key is provided, or "mock" for local development without paid keys
AI_PROVIDER="mock"
GEMINI_API_KEY=""

# Security
SECRET_KEY="planwise-ai-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
