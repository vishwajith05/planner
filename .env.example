# ==============================================================================
# PlanWise AI - Environment Configuration Template
# ==============================================================================

# Application Metadata
PROJECT_NAME="PlanWise AI"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS Configuration
BACKEND_CORS_ORIGINS=["*"]

# Database Configuration (Lightweight SQLite for 8GB RAM local development)
DATABASE_URL="sqlite:///./planwise.db"

# JWT Authentication Security
# Must be at least 64 characters long in production
SECRET_KEY="planwise-ai-super-secure-jwt-secret-key-32-chars-long-minimum-phase2"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration ("mock" for zero-cost offline, "gemini" for external LLM)
AI_PROVIDER="mock"
GEMINI_API_KEY=""

# Offline Sync & Rate Limiting Settings
MAX_LOGIN_ATTEMPTS_PER_MINUTE=30
